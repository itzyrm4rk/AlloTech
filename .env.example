# ==============================================================================
# AlloTech — Variables d'environnement d'exemple
# TOUS LES SERVICES UTILISENT DES PALIERS 100% GRATUITS SANS CARTE BANCAIRE
# ==============================================================================

# 1. Base de données PostgreSQL Serverless (Neon - https://neon.tech)
# Gratuit sans CB requise
DATABASE_URL="postgresql://user:password@ep-sample-project.eu-central-1.aws.neon.tech/allotech?sslmode=require"

# 2. Authentification (Better Auth)
BETTER_AUTH_SECRET="change-this-secret-to-a-random-32-chars-string"
BETTER_AUTH_URL="http://localhost:3000"

# 3. Cache & Rate Limiting (Upstash Redis - https://upstash.com)
# Gratuit sans CB requise
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# 4. Stockage de fichiers Médias S3-compatible (Backblaze B2 - https://www.backblaze.com/b2)
# 10 Go gratuits sans CB requise
B2_ENDPOINT=""
B2_KEY_ID=""
B2_APPLICATION_KEY=""
B2_BUCKET_NAME=""

# 5. Assistant Diagnostic IA (Google Gemini API - Google AI Studio)
# Gratuit sans CB requise
GEMINI_API_KEY=""

# 6. Emails transactionnels (Resend - https://resend.com)
# Gratuit sans CB requise
RESEND_API_KEY=""

# 7. Calcul d'itinéraires (OpenRouteService - https://openrouteservice.org)
# 2000 requêtes/jour gratuites sans CB requise
OPENROUTESERVICE_API_KEY=""
