# ==============================================================================
# AlloTech — Variables d'environnement pour déploiement Vercel & Production
# ==============================================================================

# URL publique de l'application (à remplacer par l'URL Vercel en production)
NEXT_PUBLIC_APP_URL="https://votre-projet.vercel.app"

# 1. Base de données PostgreSQL (Neon Serverless)
DATABASE_URL="postgresql://user:password@endpoint-pooler.region.neon.tech/neondb?sslmode=require"

# 2. Authentification (Better Auth)
BETTER_AUTH_SECRET="votre-secret-aleatoire-32-caracteres"
BETTER_AUTH_URL="https://votre-projet.vercel.app"

# 3. Stockage Médias (Backblaze B2 - Compatible AWS S3 v3)
B2_KEY_ID="0051013e37fc4cd0000000001"
B2_APP_KEY="votre-app-key-backblaze"
B2_BUCKET_NAME="allotech-medias-prod"
B2_ENDPOINT="https://s3.us-east-005.backblazeb2.com"
B2_REGION="us-east-005"

# 4. Service d'emails transactionnels (Gmail SMTP / Nodemailer)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="votre-email@gmail.com"
SMTP_PASS="votre-mot-de-passe-application"
SMTP_FROM_NAME="AlloTech Support"

# 5. Diagnostic IA Prédictif (Google Gemini)
GEMINI_API_KEY="votre-cle-api-gemini"
